{
  "name": "@nasani/figma-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first NASANI MCP for Figma-to-code in the active coding session, with optional remote hosting",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nasani-mcp": "bin/nasani.cjs"
  },
  "scripts": {
    "start": "node bin/nasani.cjs serve",
    "test": "node --test test/system.test.cjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "agents",
    "deploy",
    "README.md",
    "TESTING.md",
    "Dockerfile",
    "compose.yaml",
    ".env.example"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "css-tree": "2.3.1",
    "parse5": "6.0.1",
    "zod": "4.6.7"
  }
}
